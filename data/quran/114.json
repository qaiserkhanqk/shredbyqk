{"s":114,"name":"An-Nas","meaning":"Mankind","arName":"سُورَةُ النَّاسِ","type":"Meccan","verses":6,"juz":30,"page":604,"basmala":true,"ayahs":[{"a":1,"ar":"قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","en":"Say, \"I seek refuge in the Lord of mankind,","juz":30,"page":604},{"a":2,"ar":"مَلِكِ ٱلنَّاسِ","en":"The Sovereign of mankind.","juz":30,"page":604},{"a":3,"ar":"إِلَٰهِ ٱلنَّاسِ","en":"The God of mankind,","juz":30,"page":604},{"a":4,"ar":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","en":"From the evil of the retreating whisperer -","juz":30,"page":604},{"a":5,"ar":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","en":"Who whispers [evil] into the breasts of mankind -","juz":30,"page":604},{"a":6,"ar":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","en":"From among the jinn and mankind.\"","juz":30,"page":604}]}