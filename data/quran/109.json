{"s":109,"name":"Al-Kafirun","meaning":"The Disbelievers","arName":"سُورَةُ الكَافِرُونَ","type":"Meccan","verses":6,"juz":30,"page":603,"basmala":true,"ayahs":[{"a":1,"ar":"قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","en":"Say, \"O disbelievers,","juz":30,"page":603},{"a":2,"ar":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","en":"I do not worship what you worship.","juz":30,"page":603},{"a":3,"ar":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","en":"Nor are you worshippers of what I worship.","juz":30,"page":603},{"a":4,"ar":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","en":"Nor will I be a worshipper of what you worship.","juz":30,"page":603},{"a":5,"ar":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","en":"Nor will you be worshippers of what I worship.","juz":30,"page":603},{"a":6,"ar":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","en":"For you is your religion, and for me is my religion.\"","juz":30,"page":603}]}