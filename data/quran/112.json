{"s":112,"name":"Al-Ikhlas","meaning":"Sincerity","arName":"سُورَةُ الإِخۡلَاصِ","type":"Meccan","verses":4,"juz":30,"page":604,"basmala":true,"ayahs":[{"a":1,"ar":"قُلْ هُوَ ٱللَّهُ أَحَدٌ","en":"Say, \"He is Allah, [who is] One,","juz":30,"page":604},{"a":2,"ar":"ٱللَّهُ ٱلصَّمَدُ","en":"Allah, the Eternal Refuge.","juz":30,"page":604},{"a":3,"ar":"لَمْ يَلِدْ وَلَمْ يُولَدْ","en":"He neither begets nor is born,","juz":30,"page":604},{"a":4,"ar":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","en":"Nor is there to Him any equivalent.\"","juz":30,"page":604}]}